# ==============================================================================
# COFRAME ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server & Network
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / Supabase or local SQLite fallback)
# Leave empty for local SQLite (default: sqlite:///./coframe.db)
DATABASE_URL=sqlite:///./coframe.db

# Supabase (Optional for remote Supabase Realtime & Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider Configuration
# Supported providers: gemini | openai | anthropic | openrouter | groq | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=

# Demo Configuration
DEMO_PROJECT_ID=demo-ledgerflow
DEBUG=true

# GitHub Integration Configuration
# Personal Access Token with repo (contents:write, pull_requests:write) permissions
GITHUB_TOKEN=
GITHUB_OWNER=Satvik-4web
GITHUB_REPO=ledgerflow-product
GITHUB_BASE_BRANCH=main
GITHUB_AUTO_CREATE_PR=true
GITHUB_WEBHOOK_SECRET=
